# Copy this file to server/.env and fill in the values. Never commit server/.env.

# "development" locally. Set it explicitly to "production" in the Azure App Service settings,
# otherwise error responses include stack traces.
NODE_ENV=development
PORT=4000

# Local MongoDB from docker compose (see the root README).
# On Azure staging this is the MongoDB Atlas connection string, set in App Service settings.
MONGODB_URI=mongodb://localhost:27017/kkfactor

# Front-end origins allowed to call the API (comma-separated).
CLIENT_ORIGIN=http://localhost:5173
